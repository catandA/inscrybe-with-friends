# 部署/构建用环境变量模板（占位值，随仓库提交）
# 本地开发实际密钥请写到 .env.local（.gitignore 已忽略）

# ===== OAuth 登录（server/auth/config.ts） =====
# Discord OAuth App
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# GitHub OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===== NextAuth v5（server/auth/config.ts） =====
# session 加密密钥，生产必须用强随机值：openssl rand -base64 32
AUTH_SECRET=""
# 兼容旧字段（v5 实际读 AUTH_SECRET，留空亦可；本地同步设上更稳）
NEXTAUTH_SECRET=""
# 非默认部署域名时强制指定，例如 https://example.com
# 本地开发用 http://localhost:3000，避免从 host 头推断出 0.0.0.0
AUTH_URL=""

# ===== 数据库（prisma/schema.prisma datasource.url） =====
# Prisma 真正读取的连接串；构建期 db:push 也读此变量
DATABASE_URL="postgresql://user:password@localhost:5432/inscrybe?schema=public"

# ===== Redis（server/kv.ts process.env.REDIS_URL） =====
# lobby / game 运行时状态存这里；auth adapter 也复用同一实例存 session
REDIS_URL="redis://127.0.0.1:6379"

# ===== Cron 定时任务（pages/api/cron/daily.ts） =====
# /api/cron/daily 用 Authorization: Bearer <CRON_SECRET> 鉴权
# 非 Vercel 部署需用宿主机 crontab / 外部 cron 服务调用该路由
CRON_SECRET=""

# ===== 日志（可选） =====
# Logtail 采集 token；不接日志服务可留空
LOGTAIL_TOKEN=""
